# ==========================================
# AGROPASSPORT - CONFIGURACIÓN DE ENTORNO
# ==========================================

NODE_ENV=production
PORT=4000

# 1. Seguridad y Cifrado
ENCRYPTION_MASTER_KEY=super_secret_master_key_change_me_in_production_2026

# 2. Control de Acceso y Rate Limiting
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000

# 3. Credenciales y mTLS Bancario / Asegurador
SANCOR_API_BASE_URL=https://ws.sancorseguros.com/agro/v3
SANCOR_CLIENT_ID=your_sancor_client_id
SANCOR_CLIENT_SECRET=your_sancor_client_secret

GALICIA_API_BASE_URL=https://api.galicia.ar/agro/v1
GALICIA_CLIENT_ID=your_galicia_client_id
GALICIA_CLIENT_SECRET=your_galicia_client_secret

MACRO_API_BASE_URL=https://api.macro.com.ar/agro/v1
MACRO_CLIENT_ID=your_macro_client_id
MACRO_CLIENT_SECRET=your_macro_client_secret

MTLS_CERT_PATH=./certs/production-client.crt
MTLS_KEY_PATH=./certs/production-client.key
MTLS_PASSPHRASE=your_certificate_passphrase_if_any