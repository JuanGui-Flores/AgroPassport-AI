datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PRODUCER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(PRODUCER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities  EntityMember[]
}

model Entity {
  id           String   @id @default(uuid())
  cuit         String   @unique
  businessName String
  code         String?
  type         String?  @default("partner")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members      EntityMember[]
  lotes        Lote[]
}

model EntityMember {
  id       String @id @default(uuid())
  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
}

// ====================================================
// MODELOS: Lotes y Telemetría IoT Satelital
// ====================================================

model Lote {
  id          String   @id @default(uuid())
  code        String   @unique // Identificador de Lote (ej: "ARG-SJ-2026")
  nombre      String           // Nombre descriptivo (ej: "Lote Norte - Cuartel 3")
  hectareas   Float
  cultivo     String?          // Tipo de cultivo (ej: "Soja 1ra")
  score       Float            // Passport Score agrícola
  ndvi        Float            // Índice de vegetación
  rindeEst    Float            // Rendimiento estimado (Tn/Ha)
  latitud     Float?
  longitud    Float?
  entityId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)
  telemetrias Telemetry[]
}

model Telemetry {
  id                String   @id @default(uuid())
  loteId            String
  humedadSuelo      Float    // Porcentaje %
  temperaturaFoliar Float    // Grados °C
  bateriaNodo       Float    // Batería del sensor %
  timestamp         DateTime @default(now())

  lote              Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
}