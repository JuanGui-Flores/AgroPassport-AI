datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PRODUCER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      Role     @default(PRODUCER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities  EntityMember[]
}

model Entity {
  id           String         @id @default(uuid())
  businessName String
  cuit         String         @unique
  code         String?
  type         String?        @default("partner")
  members      EntityMember[]
  lotes        Lote[]
  maquinarias  Maquinaria[]   // 👈 Añadir esta relación inversa
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model EntityMember {
  id       String @id @default(uuid())
  userId   String
  entityId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
}

// ====================================================
// MODELOS: Lotes y Telemetría IoT Satelital
// ====================================================

model Lote {
  id           String         @id @default(uuid())
  code         String         @unique
  nombre       String
  hectareas    Float
  cultivo      String?
  score        Float          @default(85.0)
  ndvi         Float          @default(0.70)
  rindeEst     Float          @default(4.0)
  latitud      Float?
  longitud     Float?
  entityId     String
  entity       Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  telemetrias  Telemetry[]
  maquinarias  Maquinaria[]   // 👈 Añadir esta relación inversa
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Telemetry {
  id                String   @id @default(uuid())
  loteId            String
  humedadSuelo      Float    // Porcentaje %
  temperaturaFoliar Float    // Grados °C
  bateriaNodo       Float    // Batería del sensor %
  timestamp         DateTime @default(now())

  lote              Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
}

model Maquinaria {
  id           String   @id @default(uuid())
  codigo       String   @unique
  nombre       String   // Ej: Tractor John Deere 8R, Cosechadora S780, Drone DJI Agras
  tipo         String   // Tractor, Cosechadora, Pulverizadora, Drone
  horasUso     Float    @default(0.0)
  estado       String   @default("Operativo") // Operativo, En Mantenimiento, En Lote
  entityId     String
  entity       Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  loteId       String?
  lote         Lote?    @relation(fields: [loteId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}